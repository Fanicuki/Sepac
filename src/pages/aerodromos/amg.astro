---
import PageLayout from '../../components/PageLayout.astro';

const piezas = [
  { nombre: 'L860', detalle: 'Baja intensidad elevada' },
  { nombre: 'L860', detalle: 'Baja intensidad semi-empotrada' },
  { nombre: 'L861', detalle: 'Media intensidad elevada' },
  { nombre: 'Reflector de superficie', detalle: '' },
];
---

<PageLayout titulo="ECOSEI Ayudas Visuales - Aeródromos/Helipuertos">
  <div class="prosa">
    <p>
      Las ayudas visuales EcoSEI son luminarias LED de fabricación enteramente nacional.
    </p>
    <p>
      Fueron ensayadas por el CIC (homologada) y certificadas por la Administración Nacional de Aviación Civil (ANAC), respetando la circular técnica de balizamiento (CTB) y las RAAC vigentes.
    </p>
  </div>

  <div class="galeria galeria--cuatro">
    {piezas.map((pieza) => (
      <article class="pieza">
        <div class="ficha-visual"></div>
        <div class="pieza-texto">
          <h2>{pieza.nombre}</h2>
          {pieza.detalle && <p>{pieza.detalle}</p>}
        </div>
      </article>
    ))}
  </div>
</PageLayout>
