---
import PageLayout from '../components/PageLayout.astro';
---

<PageLayout titulo="Contáctanos">
  <div class="prosa">
    <p>Llamanos para consultas sobre equipos, proyectos y servicios.</p>
  </div>

  <div class="contacto-lista">
    <a class="contacto-item" href="tel:+5491164891525">
      <span class="contacto-icono" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M8 4h3l1.5 3.5-2 1.2a12 12 0 0 0 5 5l1.2-2L20 13v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 4h2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </span>
      <span>
        <span class="contacto-tipo">Teléfono</span>
        <span class="contacto-valor">+54 9 11 6489-1525</span>
      </span>
    </a>

    <a class="contacto-item" href="tel:+5491169686646">
      <span class="contacto-icono" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M8 4h3l1.5 3.5-2 1.2a12 12 0 0 0 5 5l1.2-2L20 13v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 4h2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </span>
      <span>
        <span class="contacto-tipo">Teléfono</span>
        <span class="contacto-valor">+54 9 11 6968-6646</span>
      </span>
    </a>
  </div>
</PageLayout>
