---
// src/components/PageLayout.astro
import Navbar from './Navbar.jsx';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} | SEPAC</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1f5f9; min-height: 100vh; font-family: sans-serif;">
    
    <!-- CONTENEDOR 1: Encabezado oscuro (#1a202c) para Navbar y Título de Sección -->
    <header style="background-color: #1a202c; width: 100%; padding-top: 100px; padding-bottom: 40px; box-sizing: border-box; text-align: center;">
      <Navbar client:load />

      <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
        <h1 style="color: #ffffff; font-size: 2.5rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">
          {titulo} <span style="color: #ff6b00;">.</span>
        </h1>
      </div>
    </header>

    <!-- CONTENEDOR 2: Caja de información blanca tipo Box-Layout -->
    <main style="max-width: 1100px; margin: 30px auto 60px auto; background-color: #ffffff; padding: 40px; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); position: relative; z-index: 10; color: #334155;">
      <slot />
    </main>

  </body>
</html>