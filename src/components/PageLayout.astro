---
// src/components/PageLayout.astro
import Navbar from './Navbar.jsx';
import Footer from './Footer.jsx';
import Seo from './Seo.astro';
import '../styles/contenido.css';

interface Props {
  titulo: string;
  indexable?: boolean;
}

const { titulo, indexable = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SEPAC. Equipos de extinción de incendios y ayudas visuales para el agro, la industria, la náutica y aeródromos." />
    <Seo indexable={indexable} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} | SEPAC</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #eef1f4; background-image: radial-gradient(rgba(148, 163, 184, 0.45) 1.1px, transparent 1.1px); background-size: 22px 22px; min-height: 100vh; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; display: flex; flex-direction: column;">
    
    <!-- CONTENEDOR 1: Encabezado oscuro (#1a202c) para Navbar y Título de Sección -->
    <header style="background-color: #1a202c; width: 100%; padding-top: 100px; padding-bottom: 40px; box-sizing: border-box; text-align: center;">
      <Navbar client:load />

      <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
        <h1 class="titulo-pagina" style="color: #ffffff; font-size: 2.5rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">
          {titulo} <span style="color: #ff6b00;">.</span>
        </h1>
      </div>
    </header>

    <!-- CONTENEDOR 2: Caja de información blanca tipo Box-Layout -->
    <main class="contenido" style="max-width: 1100px; margin: -20px auto 60px auto; background-color: #ffffff; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); position: relative; z-index: 10; color: #334155; flex: 1; width: 100%; box-sizing: border-box;">
      <slot />
    </main>

    <!-- CONTENEDOR 3: Footer global -->
    <Footer client:visible />

  </body>
</html>